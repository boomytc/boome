# Command buffers use a private mailbox. Submission requires an armed ZLE-only keymap.
_boome_input_install() {
    builtin emulate -L zsh -o no_aliases -o no_warn_create_global
    [[ -o interactive && -o multibyte && -n $BOOME_INPUT_DIR ]] || builtin return
    # Drop the per-surface path even when installation cannot proceed. A nested
    # shell must not inherit it and watch the same mailbox as this one.
    builtin local mailbox=$BOOME_INPUT_DIR
    builtin unset BOOME_INPUT_DIR
    (( ! ${+_boome_input_dir} )) || builtin return
    [[ -d $mailbox && ! -L $mailbox &&
       -p $mailbox/notify && ! -L $mailbox/notify &&
       -f $mailbox/token && ! -L $mailbox/token ]] || builtin return
    builtin zmodload zsh/system && builtin zmodload zsh/files &&
        builtin zmodload zsh/datetime || builtin return
    builtin autoload -Uz add-zle-hook-widget
    builtin typeset -g _boome_input_dir=$mailbox
    builtin typeset -g _boome_input_token="$(<$_boome_input_dir/token)"
    builtin typeset -g _boome_input_generation="${EPOCHREALTIME}_${RANDOM}"
    builtin typeset -gi _boome_input_epoch=0 _boome_input_revision=0 _boome_input_suspended=0 _boome_input_search_active=0
    builtin typeset -g _boome_input_previous= _boome_input_ack= _boome_input_result=
    builtin typeset -gi _boome_input_fd
    builtin sysopen -r -w -o nonblock,cloexec -u _boome_input_fd -- "$_boome_input_dir/notify" || builtin return
    builtin typeset -g _boome_input_saved_keymap= _boome_input_commit_key= _boome_input_saved_buffer= _boome_input_action=
    builtin typeset -g _boome_input_search_query= _boome_input_search_match=
    builtin typeset -gi _boome_input_search_skip=0
    builtin typeset -gi _boome_input_saved_cursor=0
    builtin zle -N _boome_input_commit
    builtin zle -N _boome_input_receive
    builtin zle -F -w $_boome_input_fd _boome_input_receive
    add-zle-hook-widget line-init _boome_input_begin
    add-zle-hook-widget line-pre-redraw _boome_input_redraw
    add-zle-hook-widget line-finish _boome_input_finish
    add-zle-hook-widget keymap-select _boome_input_redraw
    add-zle-hook-widget isearch-update _boome_input_searching
    add-zle-hook-widget isearch-exit _boome_input_search_end
    builtin typeset -ag preexec_functions
    preexec_functions+=(_boome_input_finish)
}

_boome_input_publish() {
    builtin emulate -L zsh -o no_aliases -o no_warn_create_global
    # Optional arguments report a buffer without leaving it on the terminal.
    builtin local state=$1 current fd buffer=${2-${BUFFER-}} cursor=${3-${CURSOR:-0}} keymap=${KEYMAP-} context=${CONTEXT-}
    [[ -d $_boome_input_dir ]] || builtin return
    if [[ $state == ready && $KEYMAP == _boome_input_transaction ]]; then
        state=armed
    elif [[ $state == ready && ( $_boome_input_suspended == 1 || $_boome_input_search_active == 1 ||
            $CONTEXT != (start|cont) || $KEYMAP != (main|emacs|viins) ) ]]; then
        state=unsupported
    fi
    builtin local suffix=${4-${POSTDISPLAY-}}
    [[ $state == (ready|armed) ]] || suffix=
    (( $#suffix <= 4000 )) || suffix=${suffix[1,4000]}
    current="${state}:${buffer}:${cursor}:${keymap}:${context}:${_boome_input_epoch}:${_boome_input_ack}:${_boome_input_result}:${suffix}"
    [[ $current != $_boome_input_previous ]] || builtin return
    _boome_input_previous=$current
    (( ++_boome_input_revision ))
    builtin sysopen -w -o creat,trunc,cloexec -m 600 -u fd -- "$_boome_input_dir/.state" || builtin return
    builtin printf '%s\0' BOOME1 "$_boome_input_token" "$$" "$_boome_input_generation" \
        "$_boome_input_epoch" "$_boome_input_revision" "$state" "$buffer" "$cursor" \
        "$keymap" "$context" "$_boome_input_ack" "$_boome_input_result" "$suffix" >&$fd
    builtin exec {fd}>&-
    builtin zf_mv -f -- "$_boome_input_dir/.state" "$_boome_input_dir/state"
}

_boome_input_begin() {
    (( ++_boome_input_epoch ))
    POSTDISPLAY=
    _boome_input_publish ready
}
_boome_input_redraw() { _boome_input_publish ready }
_boome_input_searching() { _boome_input_search_active=1; _boome_input_publish ready }
_boome_input_search_end() { _boome_input_search_active=0; _boome_input_publish ready }
_boome_input_finish() {
    if [[ $_boome_input_result == armed ]]; then
        _boome_input_restore abort
        _boome_input_result=rejected
    fi
    _boome_input_publish busy
}

_boome_input_receive() {
    builtin emulate -L zsh -o no_aliases -o no_warn_create_global
    builtin local drained fd value
    builtin local -a fields
    builtin sysread -i $_boome_input_fd -s 4096 drained 2>/dev/null
    [[ -f $_boome_input_dir/request && ! -L $_boome_input_dir/request ]] || builtin return
    builtin sysopen -r -o cloexec -u fd -- "$_boome_input_dir/request" || builtin return
    while IFS= builtin read -r -d '' -u $fd value; do
        fields+=("$value")
        (( ${#fields} <= 10 )) || builtin break
    done
    builtin exec {fd}<&-
    (( ${#fields} == 10 )) || builtin return
    [[ ${fields[1]} == BOOME1 && ${fields[2]} == $_boome_input_token ]] || builtin return
    if [[ ${fields[7]} == abort && ${fields[6]} == $_boome_input_ack &&
          $_boome_input_result == armed && $KEYMAP == _boome_input_transaction ]]; then
        _boome_input_restore abort
        _boome_input_result=rejected
        _boome_input_publish ready
        builtin return
    fi
    [[ ${fields[6]} != $_boome_input_ack && -n ${fields[6]} &&
       ${fields[6]} != *[^0-9A-Fa-f-]* ]] || builtin return
    # Capture any shell-side edit that happened since the app's last snapshot.
    _boome_input_publish ready
    builtin local valid=1 previous_buffer=$BUFFER previous_cursor=${CURSOR:-0} redraw=1
    [[ ${fields[3]} == $_boome_input_generation &&
       ${fields[4]} == $_boome_input_epoch &&
       ${fields[5]} == $_boome_input_revision &&
       $CONTEXT == (start|cont) && $KEYMAP == (main|emacs|viins) &&
       $_boome_input_suspended == 0 && $_boome_input_search_active == 0 ]] || valid=0
    [[ ${fields[8]} == <-> && ${fields[10]} == <-> ]] || valid=0
    (( valid && fields[8] >= EPOCHSECONDS && fields[8] <= EPOCHSECONDS + 10 &&
       fields[10] <= ${#fields[9]} )) || valid=0
    [[ ${fields[7]} == (submit|terminal|complete|search|previous|next|cancel|suggest) ]] || valid=0
    _boome_input_ack=${fields[6]}
    _boome_input_result=rejected
    if (( ! valid )); then
        _boome_input_publish ready
        builtin return
    fi
    if [[ ${fields[7]} == (submit|complete|search) ]]; then
        _boome_input_saved_buffer=$BUFFER
        _boome_input_saved_cursor=$CURSOR
        _boome_input_action=${fields[7]}
    fi
    BUFFER=${fields[9]}
    CURSOR=${fields[10]}
    if [[ ${fields[7]} == (submit|complete|search) ]]; then
        _boome_input_result=armed
    else
        _boome_input_result=accepted
    fi
    builtin zf_rm -f -- "$_boome_input_dir/request"
    case ${fields[7]} in
        submit|complete|search)
            # zsh 5.9 cannot finish its current read from an FD widget. Hold
            # ZLE in an empty keymap until the app sends this request's commit
            # key. Ordinary input cannot start a program during this handshake.
            _boome_input_saved_keymap=$KEYMAP
            _boome_input_commit_key=$'\e[99;'"${fields[6]}"'~'
            # getkeycmd may already hold the old keymap while waiting for FD
            # events. The first commit key must be valid in that map as well.
            builtin bindkey -M $_boome_input_saved_keymap "$_boome_input_commit_key" _boome_input_commit
            builtin bindkey -N _boome_input_transaction
            builtin bindkey -M _boome_input_transaction "$_boome_input_commit_key" _boome_input_commit
            builtin zle -K _boome_input_transaction
            _boome_input_result=armed
            _boome_input_publish armed
            ;;
        previous) builtin zle up-line-or-history; _boome_input_refresh_suggestion; _boome_input_publish ready ;;
        next) builtin zle down-line-or-history; _boome_input_refresh_suggestion; _boome_input_publish ready ;;
        cancel) BUFFER=; CURSOR=0; POSTDISPLAY=; _boome_input_publish ready ;;
        suggest)
            # The plugin reads BUFFER, but the typed text must not be drawn
            # into the prompt. Restoring the previous line keeps the grid still.
            _boome_input_refresh_suggestion
            builtin local typed=$BUFFER typed_cursor=$CURSOR suffix=${POSTDISPLAY-}
            BUFFER=$previous_buffer
            CURSOR=$previous_cursor
            POSTDISPLAY=
            _boome_input_publish ready "$typed" "$typed_cursor" "$suffix"
            # That snapshot is the editor line. The prompt buffer is unchanged.
            # The next request republishes the prompt before checking the
            # revision; remember the resting line so that republish is not a
            # false shell edit and the submission is not rejected.
            _boome_input_previous="ready:${BUFFER}:${CURSOR:-0}:${KEYMAP-}:${CONTEXT-}:${_boome_input_epoch}:${_boome_input_ack}:${_boome_input_result}:"
            redraw=0
            ;;
        terminal) POSTDISPLAY=; _boome_input_publish ready ;;
    esac
    (( redraw )) && builtin zle -R
}

_boome_input_restore() {
    [[ $KEYMAP == _boome_input_transaction ]] && builtin zle -K $_boome_input_saved_keymap
    builtin bindkey -M $_boome_input_saved_keymap -r "$_boome_input_commit_key"
    builtin bindkey -D _boome_input_transaction
    if [[ ${1-} == abort ]]; then
        BUFFER=$_boome_input_saved_buffer
        CURSOR=$_boome_input_saved_cursor
    fi
    _boome_input_saved_buffer=
}

_boome_input_commit() {
    _boome_input_restore
    _boome_input_result=accepted
    if [[ $_boome_input_action == submit ]]; then
        _boome_input_publish busy
        builtin zle accept-line
        builtin return
    fi
    case $_boome_input_action in
        complete)
            # Run whichever widget Tab is bound to, so plugin completers stay
            # in the chain. Suppress only the on-screen list.
            builtin local -a binding
            builtin local widget
            binding=(${(z)"$(builtin bindkey -M ${KEYMAP:-emacs} '^I' 2>/dev/null)"})
            widget=${binding[2]:-expand-or-complete}
            [[ -n $widget && $widget != undefined-key ]] || widget=expand-or-complete
            builtin setopt local_options no_auto_list no_list_beep
            builtin zle $widget
            _boome_input_refresh_suggestion
            ;;
        search) _boome_input_history_search ;;
    esac
    _boome_input_publish ready
}

# Ask the loaded autosuggest plugin, when it is present, for the suffix it
# would draw. The editor shows that suffix. Nothing is written to the PTY.
_boome_input_refresh_suggestion() {
    builtin emulate -L zsh -o no_aliases -o no_warn_create_global
    POSTDISPLAY=
    (( ${+functions[_zsh_autosuggest_fetch_suggestion]} )) || builtin return
    [[ -n $BUFFER && ${CURSOR:-0} == $#BUFFER ]] || builtin return
    builtin local suggestion
    _zsh_autosuggest_fetch_suggestion "$BUFFER"
    [[ -n $suggestion && $suggestion != $BUFFER ]] || builtin return
    POSTDISPLAY=${suggestion:${#BUFFER}}
}

# Ctrl+R stays in the editor. The request text is the query. The same query
# again walks to the next older literal match. Nothing is typed into the PTY.
_boome_input_history_search() {
    builtin emulate -L zsh -o no_aliases -o no_warn_create_global
    builtin local query=$BUFFER line skipped=0 i
    builtin local -a lines
    if [[ $query != $_boome_input_search_query ]]; then
        _boome_input_search_query=$query
        _boome_input_search_skip=0
        _boome_input_search_match=
    else
        (( ++_boome_input_search_skip ))
    fi
    lines=(${(f)"$(builtin fc -ln 1 2>/dev/null)"})
    for (( i = $#lines; i >= 1; i-- )); do
        line=$lines[i]
        [[ -n $line ]] || continue
        # (b) is literal inside a subscript. [[ == ]] treats that backslash as text.
        [[ -z $query || ${line[(i)${(b)query}]} -le $#line ]] || continue
        if (( skipped == _boome_input_search_skip )); then
            BUFFER=$line
            CURSOR=$#line
            _boome_input_search_match=$line
            builtin return
        fi
        (( ++skipped ))
    done
    [[ -n $_boome_input_search_match ]] && BUFFER=$_boome_input_search_match && CURSOR=$#BUFFER
}

_boome_input_install
